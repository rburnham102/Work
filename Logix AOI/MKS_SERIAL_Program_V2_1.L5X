<Programs Use="Context">
<Program Use="Target" Name="MKS" TestEdits="false" MainRoutineName="MKS_DISPATCH" Disabled="false" Class="Standard" UseAsFolder="false">
<Description>
<![CDATA[MKS T2BA valve over ProSoft PLX3x ASCII. V2.1: single comm handler, request/done sequences, reply validation, valve error status (VST), status (R7/R37), interlock (RIN), comm and PLX fault reporting.]]>
</Description>
<Tags>
<Tag Name="Home_Request" TagType="Base" DataType="BOOL" Radix="Decimal" Usage="Public" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[HMI/Program: send a single Home (J) command. One command per press.]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
</Tag>
<Tag Name="Open_Request" TagType="Base" DataType="BOOL" Radix="Decimal" Usage="Public" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[HMI/Program: send Open (O). One command per press. Blocked while homing.]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
</Tag>
<Tag Name="Close_Request" TagType="Base" DataType="BOOL" Radix="Decimal" Usage="Public" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[HMI/Program: send Close (C). One command per press. Blocked while homing.]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
</Tag>
<Tag Name="Serial_Control_Request" TagType="Base" DataType="BOOL" Radix="Decimal" Usage="Public" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[HMI/Program: put valve in serial control (xjp1 then D1). Runs once per request.]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
</Tag>
<Tag Name="Analog_Control_Request" TagType="Base" DataType="BOOL" Radix="Decimal" Usage="Public" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[HMI/Program: return valve to analog setpoint (D0). One command per press.]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
</Tag>
<Tag Name="Homing_MKS_Valve_Request" TagType="Base" DataType="BOOL" Radix="Decimal" Usage="Public" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[HMI/Program: run full homing sequence (xjp1, D1, J, wait, D0). Runs once per request; release to re-arm.]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
</Tag>
<Tag Name="Read_Position_Active" TagType="Base" DataType="BOOL" Radix="Decimal" Usage="Public" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Enable background polling: position (R6), status (R7, R37), errors (VST), interlock (RIN).]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
</Tag>
<Tag Name="Valve_POS_Active" TagType="Base" DataType="BOOL" Radix="Decimal" Usage="Public" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Enable serial position control. Valve is driven to Valve_POS_SP_INT; resent when setpoint changes.]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
</Tag>
<Tag Name="Valve_POS_SP_INT" TagType="Base" DataType="INT" Radix="Decimal" Usage="Public" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Position setpoint in % open (0-100). Clamped before sending.]]>
</Description>
<Data Format="L5K">
<![CDATA[25]]>
</Data>
</Tag>
<Tag Name="Valve_POS_Real" TagType="Base" DataType="REAL" Radix="Float" Usage="Public" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Valve position in % open, from the R6 reply.]]>
</Description>
<Data Format="L5K">
<![CDATA[0.0]]>
</Data>
</Tag>
<Tag Name="Homing_Active" TagType="Base" DataType="BOOL" Radix="Decimal" Usage="Public" Constant="false" ExternalAccess="Read/Write">
