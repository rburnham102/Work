</Description>
<Data Format="L5K">
<![CDATA[[0,100,0]]]>
</Data>
</Tag>
<Tag Name="Comm_Retry_Timer" TagType="Base" DataType="TIMER" Constant="false" ExternalAccess="Read/Write">
