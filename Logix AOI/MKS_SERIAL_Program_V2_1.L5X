<Tag Name="Comm_Step" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Comm handler step. 0 idle, 5 build, 6 pre-read, 10 send, 20/22/25 wait reply, 26-52 parse, 30 done/gap, 90 fault/retry.]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
</Tag>
<Tag Name="Cmd_Code" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Command being handled: 1 xjp1, 2 D1, 3 D0, 4 J, 5 O, 6 C, 7 T10, 8 S1xx, 9 R6, 10 R7, 11 VST, 12 RIN, 13 R37. 9 and up expect a reply.]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
</Tag>
<Tag Name="Tx_MSG" TagType="Base" DataType="MESSAGE" ExternalAccess="Read/Write">
<Description>
<![CDATA[The ONLY transmit MSG. Writes Tx_Buf to PLX SintData[4000] (ASCII transmit block).]]>
</Description>
<Data Format="Message">
<MessageParameters MessageType="CIP Data Table Write" RemoteElement="SintData[4000]" RequestedLength="40" ConnectedFlag="2" ConnectionPath="Prosoft" CommTypeCode="0" LocalIndex="0" LocalElement="Tx_Buf[0]"/>
</Data>
</Tag>
<Tag Name="Rx_MSG" TagType="Base" DataType="MESSAGE" ExternalAccess="Read/Write">
<Description>
<![CDATA[The ONLY receive MSG. Reads PLX SintData[0] (ASCII receive block) into Rx_Buf.]]>
</Description>
<Data Format="Message">
<MessageParameters MessageType="CIP Data Table Read" RemoteElement="SintData[0]" RequestedLength="80" ConnectedFlag="2" ConnectionPath="Prosoft" CommTypeCode="0" LocalIndex="0" LocalElement="Rx_Buf[0]"/>
</Data>
</Tag>
