<Rung Number="17" Type="N">
<Text><![CDATA[EQU(Comm_Step,50)GRT(Meas_Count,10)[MOV(Meas_Order[10],Fld_Item) ,MOV(0,Fld_Comma) ,LEQ(Fld_Start,Rx_Text.LEN) FIND(Rx_Text,Str_Comma,Fld_Start,Fld_Comma) ,GRT(Fld_Comma,0) SUB(Fld_Comma,Fld_Start,Fld_Qty) ,EQU(Fld_Comma,0) SUB(Rx_Text.LEN,Fld_Start,Fld_Qty) ADD(Fld_Qty,1,Fld_Qty) ,NEQ(Meas_Count,11) EQU(Fld_Comma,0) MOV(1,Parse_Bad) ,EQU(Meas_Count,11) GRT(Fld_Comma,0) MOV(1,Parse_Bad) ,GRT(Fld_Qty,20) MOV(1,Parse_Bad) ,LIM(1,Fld_Qty,20) MID(Rx_Text,Fld_Qty,Fld_Start,Fld_Text) STOR(Fld_Text,Meas_Stage_Val[Fld_Item]) MOV(1,Meas_Stage_Stat[Fld_Item]) ,LEQ(Fld_Qty,0) MOV(2,Meas_Stage_Stat[Fld_Item]) ,GRT(Fld_Comma,0) ADD(Fld_Comma,1,Fld_Start) ,EQU(Fld_Comma,0) ADD(Rx_Text.LEN,1,Fld_Start) ];]]></Text>
</Rung>
<Rung Number="18" Type="N">
<Text><![CDATA[EQU(Comm_Step,50)GRT(Meas_Count,11)[MOV(Meas_Order[11],Fld_Item) ,MOV(0,Fld_Comma) ,LEQ(Fld_Start,Rx_Text.LEN) FIND(Rx_Text,Str_Comma,Fld_Start,Fld_Comma) ,GRT(Fld_Comma,0) SUB(Fld_Comma,Fld_Start,Fld_Qty) ,EQU(Fld_Comma,0) SUB(Rx_Text.LEN,Fld_Start,Fld_Qty) ADD(Fld_Qty,1,Fld_Qty) ,NEQ(Meas_Count,12) EQU(Fld_Comma,0) MOV(1,Parse_Bad) ,EQU(Meas_Count,12) GRT(Fld_Comma,0) MOV(1,Parse_Bad) ,GRT(Fld_Qty,20) MOV(1,Parse_Bad) ,LIM(1,Fld_Qty,20) MID(Rx_Text,Fld_Qty,Fld_Start,Fld_Text) STOR(Fld_Text,Meas_Stage_Val[Fld_Item]) MOV(1,Meas_Stage_Stat[Fld_Item]) ,LEQ(Fld_Qty,0) MOV(2,Meas_Stage_Stat[Fld_Item]) ,GRT(Fld_Comma,0) ADD(Fld_Comma,1,Fld_Start) ,EQU(Fld_Comma,0) ADD(Rx_Text.LEN,1,Fld_Start) ];]]></Text>
</Rung>
<Rung Number="19" Type="N">
<Text><![CDATA[EQU(Comm_Step,50)GRT(Meas_Count,12)[MOV(Meas_Order[12],Fld_Item) ,MOV(0,Fld_Comma) ,LEQ(Fld_Start,Rx_Text.LEN) FIND(Rx_Text,Str_Comma,Fld_Start,Fld_Comma) ,GRT(Fld_Comma,0) SUB(Fld_Comma,Fld_Start,Fld_Qty) ,EQU(Fld_Comma,0) SUB(Rx_Text.LEN,Fld_Start,Fld_Qty) ADD(Fld_Qty,1,Fld_Qty) ,NEQ(Meas_Count,13) EQU(Fld_Comma,0) MOV(1,Parse_Bad) ,EQU(Meas_Count,13) GRT(Fld_Comma,0) MOV(1,Parse_Bad) ,GRT(Fld_Qty,20) MOV(1,Parse_Bad) ,LIM(1,Fld_Qty,20) MID(Rx_Text,Fld_Qty,Fld_Start,Fld_Text) STOR(Fld_Text,Meas_Stage_Val[Fld_Item]) MOV(1,Meas_Stage_Stat[Fld_Item]) ,LEQ(Fld_Qty,0) MOV(2,Meas_Stage_Stat[Fld_Item]) ,GRT(Fld_Comma,0) ADD(Fld_Comma,1,Fld_Start) ,EQU(Fld_Comma,0) ADD(Rx_Text.LEN,1,Fld_Start) ];]]></Text>
</Rung>
<Rung Number="20" Type="N">
<Text><![CDATA[EQU(Comm_Step,50)GRT(Meas_Count,13)[MOV(Meas_Order[13],Fld_Item) ,MOV(0,Fld_Comma) ,LEQ(Fld_Start,Rx_Text.LEN) FIND(Rx_Text,Str_Comma,Fld_Start,Fld_Comma) ,GRT(Fld_Comma,0) SUB(Fld_Comma,Fld_Start,Fld_Qty) ,EQU(Fld_Comma,0) SUB(Rx_Text.LEN,Fld_Start,Fld_Qty) ADD(Fld_Qty,1,Fld_Qty) ,NEQ(Meas_Count,14) EQU(Fld_Comma,0) MOV(1,Parse_Bad) ,EQU(Meas_Count,14) GRT(Fld_Comma,0) MOV(1,Parse_Bad) ,GRT(Fld_Qty,20) MOV(1,Parse_Bad) ,LIM(1,Fld_Qty,20) MID(Rx_Text,Fld_Qty,Fld_Start,Fld_Text) STOR(Fld_Text,Meas_Stage_Val[Fld_Item]) MOV(1,Meas_Stage_Stat[Fld_Item]) ,LEQ(Fld_Qty,0) MOV(2,Meas_Stage_Stat[Fld_Item]) ,GRT(Fld_Comma,0) ADD(Fld_Comma,1,Fld_Start) ,EQU(Fld_Comma,0) ADD(Rx_Text.LEN,1,Fld_Start) ];]]></Text>
</Rung>
<Rung Number="21" Type="N">
<Comment><![CDATA[Whole reply good: rate of change from the filtered temperature (degF per second, time measured by ROC_Timer), then copy values and status. RES restarts the timer for the next poll.]]></Comment>
<Text><![CDATA[EQU(Comm_Step,50)EQU(Parse_Bad,0)[EQU(Meas_Stage_Stat[1],1) EQU(ROC_Prev_OK,1) GRT(ROC_Timer.ACC,0) SUB(Meas_Stage_Val[1],ROC_FT_Prev,ROC_Delta) ABS(ROC_Delta,ROC_Delta) MUL(ROC_Delta,1000.0,ROC_Delta) MOV(ROC_Timer.ACC,ROC_Elapsed) DIV(ROC_Delta,ROC_Elapsed,ROC_Value) ,EQU(Meas_Stage_Stat[1],1) MOV(Meas_Stage_Val[1],ROC_FT_Prev) MOV(1,ROC_Prev_OK) ,NEQ(Meas_Stage_Stat[1],1) MOV(0,ROC_Prev_OK) MOV(0.0,ROC_Value) ,RES(ROC_Timer) ,COP(Meas_Stage_Val[0],Meas_Value[0],14) ,COP(Meas_Stage_Stat[0],Meas_Status[0],14) ,MOV(30,Comm_Step) ];]]></Text>
</Rung>
<Rung Number="22" Type="N">
<Comment><![CDATA[Reply did not match the poll line - reject and keep waiting.]]></Comment>
<Text><![CDATA[EQU(Comm_Step,50)[ADD(Rx_Reject_Count,1,Rx_Reject_Count) ,MOV(22,Comm_Step) ];]]></Text>
</Rung>
<Rung Number="23" Type="N">
<Comment><![CDATA[STEP 60 - PARSE GET REPLY. Value = text after '=' if there is one, otherwise the whole reply.]]></Comment>
<Text><![CDATA[EQU(Comm_Step,60)[MOV(0,Get_Text.LEN) ,MOV(0,Get_Eq_Pos) ,GEQ(Rx_Text.LEN,1) FIND(Rx_Text,Str_Equal,1,Get_Eq_Pos) ,GRT(Get_Eq_Pos,0) SUB(Rx_Text.LEN,Get_Eq_Pos,Get_Qty) LIM(1,Get_Qty,80) ADD(Get_Eq_Pos,1,Get_Eq_Pos) MID(Rx_Text,Get_Qty,Get_Eq_Pos,Get_Text) ,EQU(Get_Eq_Pos,0) LIM(1,Rx_Text.LEN,80) MID(Rx_Text,Rx_Text.LEN,1,Get_Text) ];]]></Text>
</Rung>
<Rung Number="24" Type="N">
<Comment><![CDATA[Remove up to two leading spaces.]]></Comment>
<Text><![CDATA[EQU(Comm_Step,60)GEQ(Get_Text.LEN,1)EQU(Get_Text.DATA[0],32)[DELETE(Get_Text,1,1,Get_Work) ,COP(Get_Work,Get_Text,1) ];]]></Text>
</Rung>
<Rung Number="25" Type="N">
<Text><![CDATA[EQU(Comm_Step,60)GEQ(Get_Text.LEN,1)EQU(Get_Text.DATA[0],32)[DELETE(Get_Text,1,1,Get_Work) ,COP(Get_Work,Get_Text,1) ];]]></Text>
</Rung>
<Rung Number="26" Type="N">
<Comment><![CDATA[A poll reply (has a comma) arriving for a non-text setting is not ours - reject.]]></Comment>
<Text><![CDATA[EQU(Comm_Step,60)LIM(0,Get_Target,92)NEQ(Set_Type[Get_Target],2)[MOV(0,Get_Comma_Pos) ,GEQ(Get_Text.LEN,1) FIND(Get_Text,Str_Comma,1,Get_Comma_Pos) ,GRT(Get_Comma_Pos,0) ADD(Rx_Reject_Count,1,Rx_Reject_Count) MOV(22,Comm_Step) ];]]></Text>
</Rung>
<Rung Number="27" Type="N">
<Comment><![CDATA[Store: text always. Text settings: OK (1), even if blank. Others: blank = not supported (3), starts with a digit or '-' = number (1), anything else = not numeric (2). Engineering value = raw / divisor.]]></Comment>
<Text><![CDATA[EQU(Comm_Step,60)LIM(0,Get_Target,92)[COP(Get_Text,Set_Text[Get_Target],1) ,NEQ(Set_Type[Get_Target],2) EQU(Get_Text.LEN,0) MOV(3,Set_Status[Get_Target]) ,NEQ(Set_Type[Get_Target],2) GEQ(Get_Text.LEN,1) MOV(2,Set_Status[Get_Target]) ,EQU(Set_Type[Get_Target],2) MOV(1,Set_Status[Get_Target]) ,GEQ(Get_Text.LEN,1) NEQ(Set_Type[Get_Target],2) [LIM(48,Get_Text.DATA[0],57) ,EQU(Get_Text.DATA[0],45) ] STOD(Get_Text,Set_Raw[Get_Target]) MOV(1,Set_Status[Get_Target]) MOV(Set_Raw[Get_Target],Get_Real) NEQ(Set_Div[Get_Target],0) DIV(Get_Real,Set_Div[Get_Target],Set_Eng[Get_Target]) ,MOV(30,Comm_Step) ];]]></Text>
</Rung>
<Rung Number="28" Type="N">
<Comment><![CDATA[Bad index (should never happen) - reject.]]></Comment>
<Text><![CDATA[EQU(Comm_Step,60)[ADD(Rx_Reject_Count,1,Rx_Reject_Count) ,MOV(22,Comm_Step) ];]]></Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PYRO_Status_Alarms" Type="RLL">
<Description><![CDATA[Status and alarms: temperature status flags, ambient warning, comm alarms, and the two IM-style alarms done in the PLC.]]></Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[Named copies of the main values.]]></Comment>
<Text><![CDATA[[MOV(Meas_Value[0],Pyro_Unfiltered_Temp) ,MOV(Meas_Value[1],Pyro_Filtered_Temp) ,MOV(Meas_Value[3],Pyro_Ambient_Temp) ];]]></Text>
</Rung>
<Rung Number="1" Type="N">
<Comment><![CDATA[Temperature status code (FL). -1 when FL isn't being polled.]]></Comment>
<Text><![CDATA[[EQU(Meas_Status[2],1) MOV(Meas_Value[2],Pyro_Temp_Status) ,NEQ(Meas_Status[2],1) MOV(-1,Pyro_Temp_Status) ];]]></Text>
</Rung>
<Rung Number="2" Type="N">
<Comment><![CDATA[TEMPERATURE STATUS FLAGS (page 5). Each code has a second value 16 higher when ESP sample and hold is enabled.]]></Comment>
<Text><![CDATA[[EQU(Pyro_Temp_Status,0) ,EQU(Pyro_Temp_Status,16) ]OTE(Pyro_Temp_Valid);]]></Text>
</Rung>
<Rung Number="3" Type="N">
<Text><![CDATA[[EQU(Pyro_Temp_Status,3) ,EQU(Pyro_Temp_Status,19) ]OTE(Pyro_Below_Range);]]></Text>
</Rung>
<Rung Number="4" Type="N">
<Text><![CDATA[[EQU(Pyro_Temp_Status,4) ,EQU(Pyro_Temp_Status,20) ]OTE(Pyro_Above_Range);]]></Text>
</Rung>
<Rung Number="5" Type="N">
<Text><![CDATA[[EQU(Pyro_Temp_Status,5) ,EQU(Pyro_Temp_Status,21) ]OTE(Pyro_Low_Energy);]]></Text>
</Rung>
<Rung Number="6" Type="N">
<Text><![CDATA[[EQU(Pyro_Temp_Status,7) ,EQU(Pyro_Temp_Status,23) ]OTE(Pyro_Sig_Str_Low);]]></Text>
</Rung>
<Rung Number="7" Type="N">
<Text><![CDATA[[EQU(Pyro_Temp_Status,8) ,EQU(Pyro_Temp_Status,24) ]OTE(Pyro_Sig_Str_High);]]></Text>
</Rung>
<Rung Number="8" Type="N">
<Text><![CDATA[[EQU(Pyro_Temp_Status,9) ,EQU(Pyro_Temp_Status,25) ]OTE(Pyro_Sig_Dil_Low);]]></Text>
</Rung>
<Rung Number="9" Type="N">
<Text><![CDATA[[EQU(Pyro_Temp_Status,10) ,EQU(Pyro_Temp_Status,26) ]OTE(Pyro_Sig_Dil_High);]]></Text>
</Rung>
<Rung Number="10" Type="N">
<Text><![CDATA[LIM(16,Pyro_Temp_Status,26)OTE(Pyro_ESP_Hold);]]></Text>
</Rung>
<Rung Number="11" Type="N">
<Text><![CDATA[[XIC(Pyro_Below_Range) ,XIC(Pyro_Above_Range) ]OTE(Pyro_Out_Of_Range);]]></Text>
</Rung>
<Rung Number="12" Type="N">
<Comment><![CDATA[AMBIENT WARNING like the IM: ambient temp above the sensor's Ambient Limit (AMBLIM, read from the sensor).]]></Comment>
<Text><![CDATA[EQU(Meas_Status[3],1)EQU(Set_Status[62],1)GRT(Meas_Value[3],Set_Eng[62])OTE(Pyro_Ambient_Warning);]]></Text>
</Rung>
<Rung Number="13" Type="N">
<Comment><![CDATA[Rate-of-change timer (reset by the parse after each good poll).]]></Comment>
<Text><![CDATA[XIC(Poll_Enable)TON(ROC_Timer,?,?);]]></Text>
</Rung>
<Rung Number="14" Type="N">
<Comment><![CDATA[NO RESPONSE: polling on but no good poll reply for 5 s.]]></Comment>
<Text><![CDATA[XIC(Poll_Enable)[NEQ(Comm_Step,30) ,NEQ(Cmd_Code,4) ]TON(Meas_Reply_Timer,?,?);]]></Text>
</Rung>
<Rung Number="15" Type="N">
<Text><![CDATA[XIC(Meas_Reply_Timer.DN)OTE(Meas_No_Response);]]></Text>
</Rung>
<Rung Number="16" Type="N">
<Text><![CDATA[NEQ(PLX_Config_Error,0)OTE(PLX_Config_Fault);]]></Text>
</Rung>
<Rung Number="17" Type="N">
<Text><![CDATA[[XIC(Comm_Fault) ,XIC(Meas_No_Response) ,XIC(PLX_Config_Fault) ]OTE(Pyro_Comm_Alarm);]]></Text>
</Rung>
<Rung Number="18" Type="N">
<Comment><![CDATA[PLC ALARM 1 - replaces IM Alarm 1 (the IM stores its alarms, so without an IM the PLC does it). Stale data counts as an alarm (failsafe).]]></Comment>
<Text><![CDATA[[EQU(Alarm1_Param,1) EQU(Meas_Status[1],1) GRT(Meas_Value[1],Alarm1_SP) ,EQU(Alarm1_Param,2) XIC(Pyro_Out_Of_Range) ,EQU(Alarm1_Param,3) EQU(Meas_Status[3],1) GRT(Meas_Value[3],Alarm1_SP) ,EQU(Alarm1_Param,4) EQU(Meas_Status[5],1) LES(Meas_Value[5],Alarm1_SP) ,EQU(Alarm1_Param,5) EQU(Meas_Status[4],1) LES(Meas_Value[4],Alarm1_SP) ,EQU(Alarm1_Param,6) XIC(Pyro_ESP_Hold) ,EQU(Alarm1_Param,7) EQU(Meas_Status[10],1) LES(Meas_Value[10],Alarm1_SP) ,EQU(Alarm1_Param,8) GRT(ROC_Value,Alarm1_SP) ,LIM(1,Alarm1_Param,8) XIC(Meas_No_Response) ]OTE(Alarm1_Active);]]></Text>
</Rung>
<Rung Number="19" Type="N">
<Comment><![CDATA[Failsafe relay bit like the IM: on when enabled and healthy, off in alarm.]]></Comment>
<Text><![CDATA[LIM(1,Alarm1_Param,8)XIO(Alarm1_Active)OTE(Alarm1_Relay);]]></Text>
</Rung>
<Rung Number="20" Type="N">
<Comment><![CDATA[PLC ALARM 2 - replaces IM Alarm 2 (the IM stores its alarms, so without an IM the PLC does it). Stale data counts as an alarm (failsafe).]]></Comment>
<Text><![CDATA[[EQU(Alarm2_Param,1) EQU(Meas_Status[1],1) GRT(Meas_Value[1],Alarm2_SP) ,EQU(Alarm2_Param,2) XIC(Pyro_Out_Of_Range) ,EQU(Alarm2_Param,3) EQU(Meas_Status[3],1) GRT(Meas_Value[3],Alarm2_SP) ,EQU(Alarm2_Param,4) EQU(Meas_Status[5],1) LES(Meas_Value[5],Alarm2_SP) ,EQU(Alarm2_Param,5) EQU(Meas_Status[4],1) LES(Meas_Value[4],Alarm2_SP) ,EQU(Alarm2_Param,6) XIC(Pyro_ESP_Hold) ,EQU(Alarm2_Param,7) EQU(Meas_Status[10],1) LES(Meas_Value[10],Alarm2_SP) ,EQU(Alarm2_Param,8) GRT(ROC_Value,Alarm2_SP) ,LIM(1,Alarm2_Param,8) XIC(Meas_No_Response) ]OTE(Alarm2_Active);]]></Text>
</Rung>
<Rung Number="21" Type="N">
<Comment><![CDATA[Failsafe relay bit like the IM: on when enabled and healthy, off in alarm.]]></Comment>
<Text><![CDATA[LIM(1,Alarm2_Param,8)XIO(Alarm2_Active)OTE(Alarm2_Relay);]]></Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
