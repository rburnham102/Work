<Text><![CDATA[EQU(Comm_Step,50)GRT(Meas_Count,9)[MOV(Meas_Order[9],Fld_Item) ,MOV(0,Fld_Comma) ,LEQ(Fld_Start,Rx_Text.LEN) FIND(Rx_Text,Str_Comma,Fld_Start,Fld_Comma) ,GRT(Fld_Comma,0) SUB(Fld_Comma,Fld_Start,Fld_Qty) ,EQU(Fld_Comma,0) SUB(Rx_Text.LEN,Fld_Start,Fld_Qty) ADD(Fld_Qty,1,Fld_Qty) ,NEQ(Meas_Count,10) EQU(Fld_Comma,0) MOV(1,Parse_Bad) ,EQU(Meas_Count,10) GRT(Fld_Comma,0) MOV(1,Parse_Bad) ,GRT(Fld_Qty,20) MOV(1,Parse_Bad) ,LIM(1,Fld_Qty,20) MID(Rx_Text,Fld_Qty,Fld_Start,Fld_Text) STOR(Fld_Text,Meas_Stage_Val[Fld_Item]) MOV(1,Meas_Stage_Stat[Fld_Item]) ,LEQ(Fld_Qty,0) MOV(2,Meas_Stage_Stat[Fld_Item]) ,GRT(Fld_Comma,0) ADD(Fld_Comma,1,Fld_Start) ,EQU(Fld_Comma,0) ADD(Rx_Text.LEN,1,Fld_Start) ];]]></Text>
