<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.00" TargetName="ValveCtlSA" TargetType="AddOnInstructionDefinition" TargetRevision="1.0 " TargetLastEdited="2026-11-03T12:00:00.000Z" ContainsContext="true" ExportDate="Tue Nov 03 12:00:00 2026" ExportOptions="References NoRawData L5KData DecoratedData Context Dependencies ForceProtectedEncoding">
<Controller Use="Context" Name="AOI_Export">
