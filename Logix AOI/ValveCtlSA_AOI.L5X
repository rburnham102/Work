<Parameter Name="Alm_AngleDev" TagType="Base" DataType="ALARM_DIGITAL" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Digital alarm - closed angle outside allowed deviation]]>
</Description>
</Parameter>
</Parameters>
